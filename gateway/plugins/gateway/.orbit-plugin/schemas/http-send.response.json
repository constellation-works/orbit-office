{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway.http-send response",
  "type": "object",
  "required": [
    "draft",
    "task_id",
    "outcome",
    "connection",
    "method",
    "url",
    "status",
    "content_type",
    "headers",
    "body",
    "bytes",
    "truncated",
    "task_closed"
  ],
  "properties": {
    "draft": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "sent",
        "outcome_unknown"
      ],
      "description": "sent: the server answered (any status). outcome_unknown: the request went out and no reply came back; it is never retried."
    },
    "connection": {
      "type": "string"
    },
    "method": {
      "enum": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "url": {
      "type": "string"
    },
    "status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "headers": {
      "type": "object",
      "properties": {
        "cache-control": {
          "type": "string"
        },
        "content-language": {
          "type": "string"
        },
        "content-length": {
          "type": "string"
        },
        "content-range": {
          "type": "string"
        },
        "content-type": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "expires": {
          "type": "string"
        },
        "last-modified": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "retry-after": {
          "type": "string"
        },
        "x-ratelimit-limit": {
          "type": "string"
        },
        "x-ratelimit-remaining": {
          "type": "string"
        },
        "x-ratelimit-reset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "json"
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "size",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "binary"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "description": "For outcome_unknown: what is known and what to check."
    },
    "task_closed": {
      "type": "boolean"
    },
    "task_error": {
      "type": "string",
      "description": "Why the task could not be closed or commented on; the send stands."
    }
  },
  "additionalProperties": false
}
