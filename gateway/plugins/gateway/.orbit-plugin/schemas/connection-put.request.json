{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway.connection-put request",
  "type": "object",
  "description": "Create or replace a connection. Takes no secret: the app sets the returned slot with `orbit plugin secret set gateway <slot>`.",
  "required": [
    "name",
    "base_url",
    "auth"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 48
    },
    "base_url": {
      "type": "string",
      "maxLength": 2048,
      "description": "https, or plain http to a loopback address."
    },
    "auth": {
      "type": "object",
      "required": [
        "scheme"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "maxLength": 16,
          "description": "bearer, basic, header or none."
        },
        "header": {
          "type": "string",
          "maxLength": 64,
          "description": "The header the secret is sent in (scheme header)."
        },
        "username": {
          "type": "string",
          "maxLength": 256,
          "description": "The user name (scheme basic); the slot holds the password."
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 16
      },
      "maxItems": 8,
      "description": "Methods that run directly: GET and HEAD only. Default [GET]."
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 16
      },
      "maxItems": 8,
      "description": "Write methods an agent may draft for approval: POST, PUT, PATCH, DELETE."
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
