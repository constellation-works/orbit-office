{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" hook SessionStart", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" hook Stop", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" hook SessionEnd", "timeout": 3}]}]
  }
}
