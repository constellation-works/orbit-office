#!/bin/sh
# Orbit exec backend launcher (manifest backend.command).
#
# The real backend is the Rust binary `office` (crate at plugin/), produced
# either by Orbit's install-time build (`spec.build` in plugin.yaml, git+
# sources) or by `make export` for a local directory install. Both place it
# beside this launcher as `bin/office-bin`. Nothing is built at call time.
set -eu

fail() {
    # Drain the request so Orbit reads our envelope rather than EPIPE.
    cat >/dev/null 2>&1 || true
    printf '{"ok":false,"error":{"code":"%s","message":"%s","retryable":false}}\n' "$1" "$2"
    exit 0
}

[ -n "${ORBIT_PLUGIN_ROOT:-}" ] || fail launcher_env "ORBIT_PLUGIN_ROOT is not set"

bin="$ORBIT_PLUGIN_ROOT/bin/office-bin"
[ -f "$bin" ] || fail backend_missing "bin/office-bin is missing; install from a git+ pinned source (Orbit builds it) or use an export produced by 'make export' in plugin/"

exec "$bin" orbit-tool
