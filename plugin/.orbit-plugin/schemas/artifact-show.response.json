{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.artifact-show response",
  "type": "object",
  "properties": {
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "report",
            "doc",
            "draft",
            "script",
            "data",
            "review",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task": {
          "type": "string"
        },
        "produced_by": {
          "type": "object",
          "properties": {
            "crew": {
              "type": [
                "string",
                "null"
              ]
            },
            "runbook": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "crew",
            "runbook",
            "at"
          ],
          "additionalProperties": false
        },
        "approved": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "enum": [
                "user",
                "routine"
              ]
            },
            "at": {
              "type": "string"
            },
            "edited": {
              "type": "boolean"
            }
          },
          "required": [
            "by",
            "at",
            "edited"
          ],
          "additionalProperties": false
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "normal",
            "private"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "files",
        "task",
        "produced_by",
        "approved",
        "cites",
        "series",
        "version",
        "supersedes",
        "sensitivity",
        "tags"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "series_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "supersedes",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "body": {
      "type": "string",
      "description": "Text body of a report/review artifact's first Markdown companion, as written with citations inline; at most 16384 bytes, cut on a character boundary when truncated. Absent for other kinds and for binary (non-UTF-8) companions."
    },
    "truncated": {
      "type": "boolean",
      "description": "True when the body exceeded the 16384-byte limit and was cut; false when the full body is returned or there is no body."
    },
    "backlinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "domain",
              "runbook",
              "artifact"
            ]
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "via": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cites",
                "related"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "path",
          "via"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "type": "object",
      "description": "Present only for history: true. Up to 50 newest-first document commits; author identity is withheld.",
      "properties": {
        "revisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "commit": { "type": "string" },
              "time": { "type": "string", "format": "date-time" },
              "summary": { "type": "string" }
            },
            "required": ["commit", "time", "summary"],
            "additionalProperties": false
          }
        },
        "total": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      },
      "required": ["revisions", "total", "truncated"],
      "additionalProperties": false
    }
  },
  "required": [
    "artifact",
    "path",
    "files",
    "series_history",
    "backlinks",
    "truncated"
  ],
  "additionalProperties": false
}
