{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.extract request",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "kt",
        "meeting",
        "digest"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "profile"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "id"
      ]
    },
    {
      "properties": {
        "profile": {
          "const": "meeting"
        }
      }
    }
  ],
  "description": "Meeting profile without id runs the meeting inbox. With id it saves summary.md and to-dos; task is optional for meeting and adds a result artifact when supplied."
}
