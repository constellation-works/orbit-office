{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-migrate response",
  "type": "object",
  "additionalProperties": false,
  "required": ["dry_run", "proposals", "pending", "skipped_private"],
  "properties": {
    "dry_run": { "type": "boolean" },
    "proposals": {
      "type": "array",
      "description": "At most one row: the rules-page Tags removal (key rules). v1 preferences and decisions are never backfilled.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "status", "id"],
        "properties": {
          "key": { "const": "rules" },
          "kind": { "const": "knowledge_update" },
          "status": { "enum": ["filed", "already_filed", "planned", "suppressed"], "description": "planned only on a dry run; suppressed when dismissal memory holds a matching proposal." },
          "id": { "type": ["string", "null"], "description": "The proposal task; null when planned." }
        }
      }
    },
    "pending": {
      "type": "array",
      "description": "Open v1 #pending lines, reported for the user to turn into to-dos; never filed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cite", "quote", "time", "session_id", "due"],
        "properties": {
          "cite": { "type": "string", "description": "<SCR id>#L<n>" },
          "quote": { "type": "string" },
          "time": { "type": "string" },
          "session_id": { "type": "string" },
          "due": { "type": ["string", "null"] }
        }
      }
    },
    "skipped_private": { "type": "integer", "minimum": 0, "description": "Pending lines in private SCRs, never reported." }
  }
}
