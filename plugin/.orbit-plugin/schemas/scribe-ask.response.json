{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-ask response",
  "description": "A cited answer over SCR evidence. Claims survive only when every cite names a shortlisted SCR line and the quote matches that line verbatim; others are dropped and counted. Private SCR entries are cited by reference only when no open-weights route is configured. With nothing found, not_captured is true and the searched range, topics and sessions (with scribed_through) are reported.",
  "type": "object",
  "properties": {
    "question": { "type": "string" },
    "not_captured": { "type": "boolean" },
    "status": { "enum": ["answered", "not_captured", "reference_only"] },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": ["string", "null"], "maxLength": 2000 },
          "quote": { "type": ["string", "null"], "description": "Quoted span, verbatim from the cited SCR line; null when withheld." },
          "cites": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "<SCR id>#L<line> values." },
          "cite": { "type": ["string", "null"] },
          "citation": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "file_line": { "type": ["string", "null"], "description": "<path>:<line>." },
          "file:line": { "type": ["string", "null"] },
          "scr_id": { "type": ["string", "null"] },
          "id": { "type": ["string", "null"] },
          "msg": { "type": ["string", "null"], "description": "Message id." },
          "message_id": { "type": ["string", "null"] },
          "session_id": { "type": ["string", "null"] },
          "content_withheld": { "type": "boolean" }
        },
        "required": ["text", "quote", "cites", "cite", "citation", "path", "line", "file_line", "file:line", "scr_id", "id", "msg", "message_id", "session_id", "content_withheld"],
        "additionalProperties": false
      }
    },
    "dropped_claims": { "type": "integer", "minimum": 0 },
    "derived_by": {
      "type": ["object", "null"],
      "properties": {
        "route": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": true
    },
    "shortlist": { "type": "array", "items": { "type": "object" }, "description": "The model-free shortlist (scribe-query shaped entries); private entries are by reference when no route is configured." },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "private_references": { "type": "array", "items": { "type": "object" } },
    "searched": { "type": "object" },
    "since": { "type": ["string", "null"] },
    "until": { "type": ["string", "null"] },
    "date_range": {
      "type": "object",
      "properties": { "since": { "type": ["string", "null"] }, "until": { "type": ["string", "null"] } },
      "required": ["since", "until"],
      "additionalProperties": false
    },
    "topics": { "type": "array", "items": { "type": "string" } },
    "sessions": { "type": "array", "items": { "type": "object" } },
    "sessions_not_scribed_past_last_message": { "type": "array", "items": { "type": "object" }, "description": "Sessions searched with their scribed_through cursor; a session is not scribed past its last message when that cursor is behind its parsed messages." },
    "sessions_not_scribed": { "type": "array", "items": { "type": "object" } },
    "files_searched": { "type": "integer", "minimum": 0 },
    "file_count": { "type": "integer", "minimum": 0 },
    "matched": { "type": "integer", "minimum": 0 }
  },
  "required": ["question", "not_captured", "status", "claims", "dropped_claims", "derived_by", "shortlist", "evidence", "private_references", "searched", "since", "until", "date_range", "topics", "sessions", "sessions_not_scribed_past_last_message", "sessions_not_scribed", "files_searched", "file_count", "matched"],
  "additionalProperties": false
}
