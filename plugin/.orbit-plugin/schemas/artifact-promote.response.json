{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.artifact-promote response",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "path",
    "files",
    "series",
    "version",
    "supersedes"
  ],
  "additionalProperties": false
}
