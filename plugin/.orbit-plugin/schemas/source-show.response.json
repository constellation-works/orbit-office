{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.source-show response",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "path": { "type": "string" },
    "body": { "type": "string" },
    "text": { "type": "string" },
    "span": { "type": ["string", "null"] },
    "anchor": { "type": ["string", "null"] },
    "sensitivity": { "type": "string" },
    "sha256": { "type": ["string", "null"] },
    "bytes": { "type": ["integer", "null"] },
    "media_type": { "type": ["string", "null"] },
    "version": { "type": "integer" },
    "history": {
      "type": "object",
      "description": "Present only for history: true. Up to 50 newest-first document commits; author identity is withheld.",
      "properties": {
        "revisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "commit": { "type": "string" },
              "time": { "type": "string", "format": "date-time" },
              "summary": { "type": "string" }
            },
            "required": ["commit", "time", "summary"],
            "additionalProperties": false
          }
        },
        "total": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      },
      "required": ["revisions", "total", "truncated"],
      "additionalProperties": false
    }
  },
  "required": ["id", "kind", "title", "path", "body", "text", "span", "anchor", "sensitivity", "sha256", "bytes", "media_type", "version"],
  "additionalProperties": false
}
