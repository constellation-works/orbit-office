{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.source-show response",
  "type": "object",
  "properties": {
    "layer": {
      "type": "string",
      "enum": [
        "own",
        "shared"
      ]
    },
    "shared_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Sharing member; null for own documents."
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "span": {
      "type": [
        "string",
        "null"
      ]
    },
    "anchor": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensitivity": {
      "type": "string"
    },
    "shareable": {
      "type": "boolean",
      "description": "Sharing approval; false for shared-layer sources, which carry shared_by instead."
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "media_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer"
    },
    "history": {
      "type": "object",
      "description": "Present only for history: true. Up to 50 newest-first document commits; author identity is withheld.",
      "properties": {
        "revisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string"
              },
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "commit",
              "time",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "revisions",
        "total",
        "truncated"
      ],
      "additionalProperties": false
    },
    "derived_by": {
      "type": "object",
      "properties": {
        "transcription": {
          "oneOf": [
            {
              "const": "vtt-import"
            },
            {
              "type": "object",
              "properties": {
                "route": {
                  "type": "string",
                  "enum": [
                    "hosted",
                    "private:company",
                    "private:provider",
                    "private:own_hardware"
                  ]
                },
                "model": {
                  "type": "string"
                }
              },
              "required": [
                "route",
                "model"
              ],
              "additionalProperties": false
            }
          ]
        },
        "extraction": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string",
              "enum": [
                "hosted",
                "private:company",
                "private:provider",
                "private:own_hardware"
              ]
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "route",
            "model"
          ],
          "additionalProperties": false
        },
        "frames": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string",
              "enum": [
                "hosted",
                "private:company",
                "private:provider",
                "private:own_hardware"
              ]
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "route",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cited_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "task",
              "source",
              "domain",
              "runbook",
              "artifact"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "task_citers_available": {
      "type": "boolean",
      "description": "False when no Orbit callback adapter is available; task citations are then unknown."
    },
    "cited_by_truncated": {
      "type": "boolean",
      "description": "True when the bounded lookup omitted citing tasks (at most 100 returned)."
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "label": {
            "enum": [
              "core",
              "tangent"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "Start in whole seconds."
          },
          "anchor": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "title",
          "label",
          "start",
          "anchor"
        ],
        "additionalProperties": false
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_base64": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 699052
        },
        "limit_bytes": {
          "const": 524288
        },
        "too_large": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "media_type",
        "bytes",
        "content_base64",
        "limit_bytes",
        "too_large",
        "truncated"
      ],
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "minimum": 0
          },
          "anchor": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^\\d{4,10}\\.png$"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "time",
          "anchor",
          "file",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_withheld": {
      "type": "boolean",
      "description": "Present and true only for a private source: body, text, span, summary and derived chapter/frame/gotcha text are withheld; metadata only is returned."
    },
    "gotchas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "cites"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "dec-<scope>-<n>, permanent."
          },
          "question": {
            "type": "string"
          },
          "question_ref": {
            "type": "string"
          },
          "question_by": {
            "const": "scribe"
          },
          "options": {
            "oneOf": [
              {
                "const": "unrecoverable"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The option's stable id; set only by Orbit ingestion."
                    },
                    "consequence": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The option's one-line consequence; set only by Orbit ingestion."
                    }
                  },
                  "required": [
                    "text",
                    "ref"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          },
          "chosen": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "because": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text",
              "ref"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "string",
            "pattern": "^(global|project:[a-z0-9]+(-[a-z0-9]+)*)$"
          },
          "context": {
            "type": "object",
            "properties": {
              "task_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "workspace": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "task": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "risk_tier": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "decided_by": {
            "enum": [
              "human",
              "agent",
              "model"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "reverses": {
            "type": [
              "string",
              "null"
            ]
          },
          "orbit": {
            "type": [
              "object",
              "null"
            ],
            "description": "Ingestion only: the Orbit request copied from the answered request; present on ingested entries.",
            "properties": {
              "request_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "topic": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "answered_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "assessment_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "policy_digest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "probability": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "cited_precedents": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "same_as": {
            "type": [
              "string",
              "null"
            ],
            "description": "An earlier entry recording the same decision from the other source."
          },
          "confirms": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ingestion only: the decided_by model entry this human entry confirms."
          },
          "source": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "reversed_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "Derived on read: the first later entry whose reverses names this one. Never written."
          },
          "ledger": {
            "type": "string",
            "description": "The ledger id, decisions-<scope>."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "The entry's line in the ledger body (#L<n>)."
          }
        },
        "required": [
          "id",
          "ref",
          "scope",
          "context",
          "decided_by",
          "decided_at",
          "reverses",
          "source",
          "reversed_by",
          "ledger",
          "line"
        ],
        "additionalProperties": false
      },
      "description": "Present only for a decision ledger (kind decisions): every entry of a ledger id, or the one entry of an entry id or a migrated note's former id, each with derived reversed_by."
    },
    "moved_from": {
      "type": [
        "string",
        "null"
      ],
      "description": "Present only for a decision ledger: the migrated note id this read resolved through, else null."
    }
  },
  "required": [
    "id",
    "layer",
    "shared_by",
    "kind",
    "title",
    "path",
    "body",
    "text",
    "span",
    "anchor",
    "sensitivity",
    "shareable",
    "sha256",
    "bytes",
    "media_type",
    "version",
    "derived_by",
    "cited_by",
    "task_citers_available",
    "cited_by_truncated",
    "chapters",
    "frames",
    "gotchas"
  ],
  "additionalProperties": false
}
