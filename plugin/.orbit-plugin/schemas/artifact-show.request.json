{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.artifact-show request",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^art-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "history": { "type": "boolean", "default": false, "description": "Include up to 50 newest-first document revisions with total and truncation status. Omitted or false leaves the response unchanged." }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
