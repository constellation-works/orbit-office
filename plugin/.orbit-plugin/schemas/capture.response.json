{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.capture response",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "type": "string"
        },
        "deduplicated": {
          "type": "boolean"
        },
        "appended": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        },
        "handoff": {
          "type": "string",
          "enum": [
            "written",
            "disabled",
            "private",
            "invalid",
            "too_long",
            "no_plan_change",
            "no_anchor",
            "unresolved_anchor",
            "structured_required",
            "handoff_required_field",
            "handoff_observed_at_required",
            "handoff_observed_at_invalid",
            "handoff_task_id_incomplete",
            "handoff_budget_exceeded",
            "handoff_structure_invalid",
            "handoff_field_invalid",
            "handoff_assignment_required"
          ],
          "description": "Present only when the request offered a handoff: written, or why it was dropped (disabled when dom-scribe-rules does not set scribe.handoff: true)."
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "path",
        "sha256",
        "bytes",
        "media_type",
        "sensitivity",
        "deduplicated",
        "appended",
        "version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "orchestrator": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_sha256": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string"
        },
        "content_withheld": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "line",
              "role",
              "timestamp",
              "text"
            ],
            "properties": {
              "line": {
                "type": "integer"
              },
              "role": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "context": {
                "type": "boolean",
                "description": "True only for the single read-only assistant context line an incremental (from_line) preview returns before the requested range; context lines cannot be selected."
              }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "description": "The dom-scribe-rules page, passed to the crew as data; null when the Library has none and the built-in defaults apply. Rules never widen the guard.",
          "required": [
            "id",
            "path",
            "handoff",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "handoff": {
              "type": "boolean",
              "description": "scribe.handoff from the page frontmatter."
            },
            "body": {
              "type": [
                "string",
                "null"
              ],
              "description": "Page body; null for a private page, which never reaches the crew."
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "description": "The session's conversation source, or null before its first capture.",
          "required": [
            "id",
            "path",
            "extracted_through",
            "next_anchor"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "extracted_through": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Last transcript line an earlier pass considered; the next pass sends from_line one past it."
            },
            "next_anchor": {
              "type": "integer",
              "description": "One-based body line (#L<n>) the first entry this pass appends will take; later entries follow in line order."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "orchestrator",
        "model",
        "transcript_sha256",
        "sensitivity",
        "content_withheld",
        "lines",
        "rules",
        "source"
      ],
      "additionalProperties": false
    }
  ]
}
