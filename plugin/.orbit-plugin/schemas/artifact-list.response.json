{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.artifact-list response",
  "description": "Artifact summaries newest first by approved date. total counts every artifact matching the filters; truncated is true when the limit cut the list. An unreadable or invalid artifact refuses the complete read. Writes nothing.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["report", "doc", "draft", "script", "data", "review", "other"]
          },
          "series": { "type": "string" },
          "title": { "type": "string" },
          "approved_at": { "type": "string" },
          "sensitivity": {
            "type": "string",
            "enum": ["normal", "private"]
          }
        },
        "required": ["id", "kind", "series", "title", "approved_at", "sensitivity"],
        "additionalProperties": false
      }
    },
    "total": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
  },
  "required": ["artifacts", "total", "truncated"],
  "additionalProperties": false
}
