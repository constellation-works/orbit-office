{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.status response",
  "type": "object",
  "properties": {
    "version": { "type": "string", "description": "The plugin version answering the call." },
    "secrets": {
      "type": "object",
      "description": "Each declared secret name mapped to whether Orbit delivered a value. Never a value.",
      "properties": {
        "meta_api_key": { "$ref": "#/$defs/presence" },
        "baseten_token": { "$ref": "#/$defs/presence" }
      },
      "required": ["meta_api_key", "baseten_token"],
      "additionalProperties": false
    },
    "library": {
      "type": "object",
      "description": "Library and index health. Counts come from the index; an uninitialized Library reports zero counts.",
      "properties": {
        "initialized": { "type": "boolean" },
        "documents": { "type": "integer", "minimum": 0 },
        "documents_by_kind": {
          "type": "object",
          "properties": {
            "source": { "type": "integer", "minimum": 0 },
            "domain": { "type": "integer", "minimum": 0 },
            "runbook": { "type": "integer", "minimum": 0 },
            "artifact": { "type": "integer", "minimum": 0 }
          },
          "required": ["source", "domain", "runbook", "artifact"],
          "additionalProperties": false
        },
        "pages_off_template": {
          "type": "integer",
          "minimum": 0,
          "description": "Knowledge pages that name a template and no longer meet its current rules. Pages with no template field are not counted."
        },
        "template_invalid": {
          "type": "array",
          "description": "Library-relative paths of template files that do not parse, sorted. Empty when every template file is valid. A broken template does not fail the status call.",
          "items": { "type": "string" }
        }
      },
      "required": ["initialized", "documents", "documents_by_kind", "pages_off_template", "template_invalid"],
      "additionalProperties": false
    }
  },
  "required": ["version", "secrets", "library"],
  "additionalProperties": false,
  "$defs": {
    "presence": { "type": "string", "enum": ["set", "unset"] }
  }
}
