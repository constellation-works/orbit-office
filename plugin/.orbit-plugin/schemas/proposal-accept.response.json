{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.proposal-accept.response",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "accepted": {
      "const": true
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "auto_task": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "auto_task",
            "enabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "page",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "kept": {
              "const": "mine"
            }
          },
          "required": [
            "page",
            "kept"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "An accepted ledger_append: every entry appended, in order, in one commit.",
          "properties": {
            "ledger": {
              "type": "string",
              "description": "decisions-<scope slug>"
            },
            "path": {
              "type": "string"
            },
            "appended": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "dec-<scope>-<n>"
              }
            }
          },
          "required": [
            "ledger",
            "path",
            "appended"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "accepted",
    "change"
  ],
  "additionalProperties": false
}
