{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.proposal-accept.response",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "accepted": {
      "const": true
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "auto_task": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "auto_task",
            "enabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "page",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "accepted",
    "change"
  ],
  "additionalProperties": false
}
