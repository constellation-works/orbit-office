{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ics_file": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative regular .ics file, at most 1 MiB; symlinks and traversal refused."
    },
    "local": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "event"
          ],
          "properties": {
            "action": {
              "const": "create"
            },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "start",
                "end"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "all_day": {
                  "type": "boolean"
                },
                "location": {
                  "type": "string",
                  "maxLength": 1024
                },
                "agenda": {
                  "type": "string",
                  "maxLength": 8192
                },
                "attendees": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "private": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "key",
            "event"
          ],
          "properties": {
            "action": {
              "const": "update"
            },
            "key": {
              "type": "string"
            },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "start",
                "end"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "all_day": {
                  "type": "boolean"
                },
                "location": {
                  "type": "string",
                  "maxLength": 1024
                },
                "agenda": {
                  "type": "string",
                  "maxLength": 8192
                },
                "attendees": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "private": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "key"
          ],
          "properties": {
            "action": {
              "const": "delete"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "local",
            "external"
          ],
          "properties": {
            "action": {
              "const": "sources"
            },
            "local": {
              "type": "boolean"
            },
            "external": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": false,
  "not": {
    "required": [
      "ics_file",
      "local"
    ]
  }
}
