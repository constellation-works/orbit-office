{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-append request",
  "description": "Validate the scribe's entries against the parsed messages and the rules, append the accepted ones to the session's SCR file, merge topics, move scribed_through to through and commit. A note/title-only call (no entry citing a message) may omit through; it writes the note or title and leaves scribed_through unchanged. Run office.scribe-pending first. A v2 pass (format v2, or sections and findings) instead rewrites the SCR's Summary, Goals, Outcome and Next, appends one Tags entry per accepted finding, and commits the SCR with its decision ledger lines and any apply-mode preference page in one Library commit. Each finding must name a marker office.scribe-pending returned.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "Provider (engine) session identity."
    },
    "through": {
      "type": "string",
      "pattern": "^m-[0-9]{4,}$",
      "description": "The last message given to the scribe; never before the file's scribed_through. Required when any entry cites a message or when the call carries neither a note entry nor a title; omitted only for a note/title-only append, which leaves scribed_through unchanged."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A cited message (msg and quote) or a note (text alone, with by).",
        "properties": {
          "msg": {
            "type": "string",
            "pattern": "^m-[0-9]{4,}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact substring of the cited message."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Note text, written verbatim (credentials scrubbed) with note in place of a message id."
          },
          "tag": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9#._:/@-]{1,128}$"
            }
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolves": {
            "type": [
              "string",
              "null"
            ],
            "description": "<SCR id>#L<n>: resolved names a pending line, why names a decision line, a preference note names a decision line it promotes."
          },
          "why": {
            "type": [
              "object",
              "null"
            ],
            "description": "decision, agent-decision and preference only: the reason, checked verbatim against its message or note.",
            "properties": {
              "msg": {
                "type": "string",
                "pattern": "^m-[0-9]{4,}$"
              },
              "note": {
                "description": "true (quote from the entry's own note text) or the reason note text."
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "Exact substring of the cited message or note."
              }
            },
            "additionalProperties": false
          },
          "matter": {
            "type": [
              "string",
              "null"
            ],
            "description": "preference only: a matter slug from the scribe rules."
          },
          "review_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "preference only: review date; 90 days after the entry by default."
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "description": "preference only: <SCR id>#L<n> of an existing preference line on the same matter."
          },
          "by": {
            "type": [
              "string",
              "null"
            ],
            "description": "user, or the crew name an agent tag requires."
          }
        },
        "required": [
          "tag"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "msg",
              "quote"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          },
          {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "msg"
                  ]
                },
                {
                  "required": [
                    "quote"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Session title; a user title change renames the file once and records the old id in aliases. Scribe/custom titles never rename."
    },
    "counterpart": {
      "enum": [
        "orchestrator",
        "agent",
        "coworker",
        "meeting",
        "self"
      ]
    },
    "counterpart_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title_by": {
      "type": "string",
      "enum": [
        "user",
        "custom",
        "scribe"
      ],
      "description": "Who sets title: user (default, /scribe title, renames once), custom (transcript custom-title or side-session record, never renames) or scribe (agent proposal, at most eight words, never renames, refined only while scribe-set). In a v2 pass a user title wins and is never renamed; a scribe title comes from the Summary."
    },
    "format": {
      "enum": [
        "v1",
        "v2"
      ],
      "description": "v1 (entries) or v2 (sections and findings); absent, sections or findings select v2."
    },
    "sections": {
      "type": "object",
      "description": "v2: the SCR sections, rewritten each pass. Budgets: summary 500, goals 500, outcome 2000, next 1000 characters. Every next item names a task id; an observed_at: value carries a zone offset.",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "description": "v2: one finding per marker. Refused with marker_not_found when scribe-pending did not return the marker, quote_mismatch when quote is not the marker line verbatim, decided_by_mismatch when decided_by disagrees with the marker author.",
      "items": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "pattern": "^m-[0-9]{4,}$"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based line of the message the marker starts."
          },
          "tag": {
            "type": [
              "string",
              "null"
            ],
            "description": "The marker's tag; null for a #scribe <text> instruction."
          },
          "by": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "user",
              "agent",
              null
            ]
          },
          "quote": {
            "type": [
              "string",
              "null"
            ],
            "description": "The marker line verbatim; absent, the marker line is used."
          },
          "decision": {
            "type": [
              "object",
              "null"
            ],
            "description": "decisions tag: the ledger entry's fields; each verbatim field is checked against its message.",
            "properties": {
              "question": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "question_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^m-[0-9]{4,}$"
              },
              "question_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "options": {
                "description": "\"unrecoverable\", or each option verbatim with its message.",
                "anyOf": [
                  {
                    "const": "unrecoverable"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "msg": {
                          "type": "string",
                          "pattern": "^m-[0-9]{4,}$"
                        }
                      },
                      "required": [
                        "text",
                        "msg"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "chosen": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "because": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "msg": {
                        "type": "string",
                        "pattern": "^m-[0-9]{4,}$"
                      }
                    },
                    "required": [
                      "text",
                      "msg"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Absent, the marker's because: text."
              },
              "context": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "task_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "workspace": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "task": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "risk_tier": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "decided_by": {
                "enum": [
                  "human",
                  "agent",
                  "model",
                  null
                ]
              },
              "reverses": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "dec-<scope>-<n> of the entry this one reverses."
              },
              "same_as": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "dec-<scope>-<n> of an earlier entry recording the same decision; must exist. orbit, confirms and option id/consequence are ingestion-only and refused."
              }
            },
            "additionalProperties": false
          },
          "matter": {
            "type": [
              "string",
              "null"
            ],
            "description": "preferences tag: the matter slug."
          },
          "statement": {
            "type": [
              "string",
              "null"
            ],
            "description": "preferences tag: the preference in the user's words."
          },
          "conflicts": {
            "type": "array",
            "description": "preferences tag: current statements the finding contradicts; any conflict only proposes.",
            "items": {
              "type": "object",
              "properties": {
                "matter": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "cites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "matter",
                "statement",
                "cites"
              ],
              "additionalProperties": false
            }
          },
          "proposal": {
            "type": [
              "string",
              "null"
            ],
            "description": "preferences tag: the proposal id a propose-mode finding filed."
          },
          "review_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "preferences tag: review date; 90 days after the marker by default."
          },
          "task": {
            "type": [
              "string",
              "null"
            ],
            "description": "orbit_task sink or an instruction: the filed task id."
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "Instruction outcome, one word (reported, failed, ...)."
          }
        },
        "required": [
          "msg",
          "line"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "session_id"
  ],
  "additionalProperties": false
}
