{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-append response",
  "description": "What changed. Refused entries are reported and never written; duplicates of existing lines are skipped. written is false when nothing changed (no commit).",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "written": {
      "type": "boolean"
    },
    "renamed_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_through": {
      "type": [
        "string",
        "null"
      ]
    },
    "scribed_through": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "line",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0
    },
    "refused": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "msg": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "unknown_message",
              "context_message",
              "after_through",
              "author_mismatch",
              "quote_not_verbatim",
              "invalid_note",
              "missing_by",
              "invalid_by",
              "unknown_tag",
              "unknown_topic",
              "tag_not_permitted",
              "invalid_ref",
              "invalid_due",
              "missing_resolves",
              "unresolved_pending",
              "resolves_not_allowed"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "msg",
          "reason",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "session_id",
    "id",
    "path",
    "created",
    "written",
    "renamed_from",
    "previous_through",
    "scribed_through",
    "topics",
    "added",
    "duplicates",
    "refused"
  ],
  "additionalProperties": false
}
