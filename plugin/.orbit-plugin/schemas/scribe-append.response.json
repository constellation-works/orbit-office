{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-append response",
  "description": "What changed. Refused entries are reported and never written; duplicates of existing lines are skipped. written is false when nothing changed (no commit). A v2 pass reports its Tags entries, ledger ids, applied pages, proposals needed, withheld and refused findings.",
  "anyOf": [
    {
      "title": "v1",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "written": {
          "type": "boolean"
        },
        "renamed_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_through": {
          "type": [
            "string",
            "null"
          ]
        },
        "scribed_through": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "line",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "msg": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "unknown_message",
                  "context_message",
                  "after_through",
                  "author_mismatch",
                  "quote_not_verbatim",
                  "invalid_note",
                  "missing_by",
                  "invalid_by",
                  "unknown_tag",
                  "unknown_topic",
                  "tag_not_permitted",
                  "invalid_ref",
                  "invalid_due",
                  "missing_resolves",
                  "unresolved_pending",
                  "resolves_not_allowed",
                  "why_not_verbatim",
                  "why_not_allowed",
                  "missing_matter",
                  "unknown_matter",
                  "matter_not_allowed",
                  "invalid_review_by",
                  "review_by_not_allowed",
                  "invalid_supersedes",
                  "supersedes_not_allowed",
                  "unresolved_decision"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "msg",
              "reason",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_by": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "user",
            "custom",
            "scribe",
            null
          ]
        }
      },
      "required": [
        "session_id",
        "id",
        "path",
        "created",
        "written",
        "renamed_from",
        "previous_through",
        "scribed_through",
        "topics",
        "added",
        "duplicates",
        "refused",
        "title",
        "title_by"
      ],
      "additionalProperties": false
    },
    {
      "title": "v2",
      "type": "object",
      "properties": {
        "format": {
          "const": "v2"
        },
        "session_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "written": {
          "type": "boolean",
          "description": "false when the batch was refused-only or nothing changed (no commit)."
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "scribed_through": {
          "type": [
            "string",
            "null"
          ]
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The Tags entry ids (T<n>) written."
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The dec-<scope>-<n> ids appended."
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "<page>#<matter> written in apply mode."
        },
        "needs_proposal": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "withheld": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reported": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "msg": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tag": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          },
          "description": "Codes include marker_not_found, quote_mismatch, decided_by_mismatch, tag_mismatch, author_mismatch, decision_invalid, preference_withheld, agent_marker_not_filed."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ledger and page paths in the same commit."
        }
      },
      "required": [
        "format",
        "session_id",
        "id",
        "path",
        "created",
        "written",
        "title",
        "title_by",
        "scope",
        "previous",
        "scribed_through",
        "added",
        "ledger",
        "applied",
        "needs_proposal",
        "withheld",
        "reported",
        "duplicates",
        "refused",
        "files"
      ],
      "additionalProperties": false
    }
  ]
}
