{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "until"
      ],
      "additionalProperties": false
    },
    "synced_at": {
      "type": "string"
    }
  },
  "required": [
    "events",
    "skipped",
    "window",
    "synced_at"
  ],
  "additionalProperties": false
}
