{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-pending response",
  "description": "The messages after scribed_through, preceded by up to 10 earlier messages marked context, with the SCR metadata and the rules. A private session is withheld: no file is written and no message is returned.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "parsed": {
      "type": [
        "string",
        "null"
      ],
      "description": "Workspace-relative path of the message file; null when withheld."
    },
    "content_withheld": {
      "type": "boolean"
    },
    "message_count": {
      "type": "integer",
      "minimum": 0
    },
    "new_count": {
      "type": "integer",
      "minimum": 0
    },
    "scr": {
      "type": [
        "object",
        "null"
      ],
      "description": "The session's SCR file, or (exists false) the name a new one takes; null while the session has no messages.",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "scribed_through": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_scribed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterpart": {
          "type": [
            "string",
            "null"
          ]
        },
        "counterpart_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_by": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "user",
            "custom",
            "scribe",
            null
          ]
        }
      },
      "required": [
        "exists",
        "id",
        "path",
        "title",
        "title_by",
        "scribed_through",
        "last_scribed_at",
        "topics",
        "aliases",
        "counterpart",
        "counterpart_name"
      ],
      "additionalProperties": false
    },
    "scribed_through": {
      "type": [
        "string",
        "null"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m-[0-9]{4,}$",
            "description": "Stable: the nth kept message is always m-<n>."
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          },
          "context": {
            "const": true,
            "description": "Present on earlier, already scribed messages: read-only context, never cited."
          }
        },
        "required": [
          "id",
          "role",
          "at",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "description": "The Tags, Topics, Matters, Capture and Models sections of dom-scribe-rules, or the spec defaults (topics: the project name; models: ask haiku@low, scribe haiku@medium).",
      "properties": {
        "source": {
          "enum": [
            "page",
            "defaults"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "authors": {
                "enum": [
                  "user",
                  "agent",
                  "any"
                ]
              }
            },
            "required": [
              "name",
              "meaning",
              "examples",
              "authors"
            ],
            "additionalProperties": false
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": "object",
          "description": "One <model>@<effort> per level from the Models section; query is model-free and present only when set.",
          "properties": {
            "query": {
              "type": "string"
            },
            "ask": {
              "type": "string"
            },
            "scribe": {
              "type": "string"
            }
          },
          "required": [
            "ask",
            "scribe"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "tags",
        "topics",
        "capture",
        "matters",
        "models"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "description": "The scribe tag definitions in force from the Library settings (scribe.tags): the configured list, else the two defaults. Distinct from rules.tags, the v1 rules-page section.",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "cadence": {
      "$ref": "#/$defs/cadence"
    }
  },
  "required": [
    "session_id",
    "provider",
    "parsed",
    "content_withheld",
    "message_count",
    "new_count",
    "scr",
    "scribed_through",
    "messages",
    "rules",
    "tags",
    "cadence"
  ],
  "additionalProperties": false,
  "$defs": {
    "tag": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "global",
            "project",
            "session"
          ]
        },
        "instruction": {
          "type": "string"
        },
        "sink": {
          "enum": [
            "decisions_ledger",
            "preference_page",
            "scr_only",
            "orbit_task"
          ]
        },
        "mode": {
          "enum": [
            "propose",
            "apply",
            "append"
          ]
        },
        "capture": {
          "enum": [
            "markers",
            "markers+inferred"
          ]
        },
        "workspace": {
          "type": "string",
          "description": "orbit_task only: the Orbit workspace selector the proposed task is filed in."
        }
      },
      "required": [
        "name",
        "scope",
        "instruction",
        "sink",
        "mode",
        "capture"
      ],
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "description": "Pass cadence: a pass starts when either threshold is reached.",
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        },
        "turns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      },
      "required": [
        "minutes",
        "turns"
      ],
      "additionalProperties": false
    }
  }
}
