{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "include_cancelled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "from",
    "until"
  ],
  "additionalProperties": false
}
