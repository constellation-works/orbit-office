{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.proposal-create.request",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "auto_task"
            },
            "definition": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "description": {
                  "type": "string"
                },
                "schedule": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "cron": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "cron"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "every_minutes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4294967295
                        }
                      },
                      "required": [
                        "every_minutes"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "template": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "acceptance_criteria": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "task_type": {
                      "enum": [
                        "feature",
                        "bug",
                        "refactor",
                        "chore"
                      ]
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required_tools": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "priority": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "complexity": {
                      "enum": [
                        "low",
                        "medium",
                        "hard",
                        "xhard"
                      ]
                    },
                    "crew": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "proposed",
                        "backlog"
                      ]
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                },
                "dedupe": {
                  "enum": [
                    "skip_if_open",
                    "always"
                  ]
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "plugin.tool_call"
                      },
                      "tool": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
                      },
                      "input": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "kind",
                      "tool",
                      "input"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "schedule",
                "template"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "definition"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "knowledge_add"
            },
            "page": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "template": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                },
                "sections": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "cites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "shareable": {
                  "type": "boolean",
                  "description": "Sharing approval; validated again at acceptance."
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            },
            "shareable": {
              "type": "boolean",
              "description": "Explicit sharing approval applied to the page Markdown and rechecked at acceptance."
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "knowledge_add"
            },
            "markdown": {
              "type": "string",
              "minLength": 1
            },
            "shareable": {
              "type": "boolean",
              "description": "Explicit sharing approval applied to the page Markdown and rechecked at acceptance."
            }
          },
          "required": [
            "kind",
            "markdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "runbook_from_friction"
            },
            "page": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "template": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                },
                "sections": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "cites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "shareable": {
                  "type": "boolean",
                  "description": "Sharing approval; validated again at acceptance."
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "runbook_from_friction"
            },
            "markdown": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "markdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "knowledge_update"
            },
            "markdown": {
              "type": "string",
              "minLength": 1
            },
            "base_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "shareable": {
              "type": "boolean",
              "description": "Explicit sharing approval applied to the page Markdown and rechecked at acceptance."
            }
          },
          "required": [
            "kind",
            "markdown",
            "base_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "retire"
            },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "auto_task"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "type",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "page"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "base_sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "title",
    "description",
    "evidence",
    "payload"
  ],
  "additionalProperties": false
}
