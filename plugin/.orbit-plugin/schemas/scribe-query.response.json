{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.scribe-query response",
  "description": "The matching SCR lines, oldest first, each with its SCR id, file path and line, message id, author, time, counterpart and resume command. With no match, results is empty and the date range and file count searched are still reported. Model-free. The v2 modes return decisions, preferences or scr cards.",
  "anyOf": [
    {
      "title": "v1",
      "type": "object",
      "properties": {
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            "pref",
            "landed",
            "why",
            null
          ],
          "description": "The canned mode requested, or null for a general filter query."
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "The full entry line as written in the SCR file."
              },
              "line_text": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "description": "The entry's quoted text."
              },
              "id": {
                "type": "string",
                "description": "The SCR file id."
              },
              "scr_id": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Library-relative SCR file path."
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "file_line": {
                "type": "string",
                "description": "<path>:<line>."
              },
              "citation": {
                "type": "string",
                "description": "<SCR id>#L<line>."
              },
              "msg": {
                "type": "string",
                "description": "Message id, or note."
              },
              "message_id": {
                "type": "string"
              },
              "time": {
                "type": "string",
                "description": "The entry's local time as written on the line."
              },
              "at": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "review_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stale": {
                "type": "boolean",
                "description": "A preference past its review_by."
              },
              "due": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolves": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "session_id": {
                "type": "string"
              },
              "counterpart": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "counterpart_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The session title, or the humanized filename slug where the SCR title is still null; never Untitled session."
              },
              "title_by": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "user",
                  "custom",
                  "scribe",
                  null
                ]
              },
              "project": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The session's project from the SCR file's front matter."
              },
              "scribed_through": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The session's scribe cursor: the last message id scribed into its SCR file. office.scribe-append takes it as through to add a note without moving the cursor."
              },
              "resume": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Resume command for the session."
              },
              "resume_command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The decision's reason: its inline why, or the #why note that filled its #no-why."
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why_source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why_filled_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "<SCR id>#L<line> of the #why note that filled this decision."
              },
              "no_why": {
                "type": "boolean",
                "description": "A decision still missing its reason."
              },
              "content_withheld": {
                "type": "boolean",
                "description": "True when the entry is private (by conversation sensitivity or the SCR file's sensitivity) and its text, quote and reason are withheld; references and anchors remain. A configured private route does not release the content to the caller."
              }
            },
            "required": [
              "text",
              "line_text",
              "quote",
              "id",
              "scr_id",
              "path",
              "line",
              "file_line",
              "citation",
              "msg",
              "message_id",
              "time",
              "at",
              "tag",
              "topics",
              "refs",
              "by",
              "matter",
              "review_by",
              "stale",
              "due",
              "resolves",
              "supersedes",
              "session_id",
              "counterpart",
              "counterpart_name",
              "title",
              "title_by",
              "project",
              "scribed_through",
              "resume",
              "resume_command",
              "why",
              "reason",
              "why_source",
              "why_filled_by",
              "no_why",
              "content_withheld"
            ],
            "additionalProperties": false
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Matches before the limit was applied."
        },
        "files_searched": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "description": "First local date searched."
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last local date searched."
        },
        "date_range": {
          "type": "object",
          "properties": {
            "since": {
              "type": [
                "string",
                "null"
              ]
            },
            "until": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "since",
            "until"
          ],
          "additionalProperties": false
        },
        "time_zone": {
          "type": "string",
          "description": "The host zone the local dates were read in (IANA name, or UTC)."
        },
        "today": {
          "type": "string",
          "description": "Today's local date in that zone."
        },
        "deprecated": {
          "type": "boolean",
          "const": true,
          "description": "Present on the v1 modes (pending, pref, landed, why) during the 30-day compatibility window: the mode still answers but is removed after the window."
        },
        "replacement": {
          "type": "string",
          "description": "With deprecated: what replaces the mode (pending: Orbit owner:you to-dos; landed: done Orbit tasks; pref: mode preferences; why: mode decisions)."
        },
        "v2_results": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "pref and why only: the v2 answer first. pref lists the preference page sections for the matter (as mode preferences returns them); why lists the ledger entries with a stated because whose text names the matter or topic (as mode decisions returns them). results then holds the v1 lines."
        }
      },
      "required": [
        "mode",
        "results",
        "count",
        "files_searched",
        "file_count",
        "since",
        "until",
        "date_range",
        "time_zone",
        "today"
      ],
      "additionalProperties": false
    },
    {
      "title": "decisions",
      "type": "object",
      "properties": {
        "mode": {
          "const": "decisions"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A ledger entry (D13 fields, including orbit, same_as and confirms and option id/consequence when present), its derived reversed_by, whether it is current, its ledger id and line."
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "ledgers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries_searched": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "decisions",
        "count",
        "ledgers",
        "entries_searched"
      ],
      "additionalProperties": false
    },
    {
      "title": "preferences",
      "type": "object",
      "properties": {
        "mode": {
          "const": "preferences"
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "page, scope, matter, citation (<page>#<matter>), statement, cites, stated_at, review_by, stale, proposed."
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "today": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "preferences",
        "count",
        "today"
      ],
      "additionalProperties": false
    },
    {
      "title": "scr",
      "type": "object",
      "properties": {
        "mode": {
          "const": "scr"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "id, path, title, title_by, scope, project, session, started, updated, previous, scribed_through, summary, goals, outcome, next, tag_entries, tag_counts (entries per Tags subsection), tags (each with its <SCR>#T<n> citation), sensitivity, content_withheld."
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "files_searched": {
          "type": "integer",
          "minimum": 0
        },
        "scr": {
          "type": "object",
          "description": "id, path, title, title_by, scope, project, session, started, updated, previous, scribed_through, summary, goals, outcome, next, tag_entries, tag_counts (entries per Tags subsection), tags (each with its <SCR>#T<n> citation), sensitivity, content_withheld."
        },
        "previous": {
          "anyOf": [
            {
              "type": "object",
              "description": "id, path, title, title_by, scope, project, session, started, updated, previous, scribed_through, summary, goals, outcome, next, tag_entries, tag_counts (entries per Tags subsection), tags (each with its <SCR>#T<n> citation), sensitivity, content_withheld."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  ]
}
