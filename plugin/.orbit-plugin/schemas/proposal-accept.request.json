{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "office.proposal-accept.request",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the exact proposal.json bytes the user reviewed."
    }
  },
  "required": [
    "id",
    "sha256"
  ],
  "additionalProperties": false
}
