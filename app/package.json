{
  "name": "orbit-office-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local web app for orbit-office: Today, To-dos, Routines, Library, Insights, Review.",
  "workspaces": [
    "packages/contracts",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsc -b && tsx watch packages/server/src/main.ts",
    "start": "node packages/server/dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
